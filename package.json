{
    "name": "ebook",
    "version": "1.0.0",
    "private": true,
    "description": "An ebook library REST API built with Express, TypeScript, MongoDB, and Cloudinary.",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/dotenv": "^6.1.1",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.96",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "http-errors": "^2.0.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.2",
        "multer": "^2.5.0",
        "slugify": "^1.6.9"
    }
}
