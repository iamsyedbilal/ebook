# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/ebook

# Generate long, random, different secrets for access and refresh tokens.
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
